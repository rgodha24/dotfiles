+package auth
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// claudeWeeklyUsedSignals is a healthy unified snapshot with the given weekly usage and reset.
+func claudeWeeklyUsedSignals(now, reset time.Time, used float64) map[string]string {
+	signals := claudeWeeklySignals(now, reset)
+	signals["Anthropic-Ratelimit-Unified-7d-Utilization"] = fmt.Sprint(used)
+	return signals
+}
+
+func withWeeklyReserve(auth *Auth, percent float64) *Auth {
+	auth.Metadata["weekly_reserve_percent"] = percent
+	return auth
+}
+
+func TestSoonestResetReserveTier(t *testing.T) {
+	t.Parallel()
+
+	now := soonestResetTestNow
+	observed := now.Add(-time.Minute)
+	for _, testCase := range []struct {
+		name string
+		auth *Auth
+		tier int
+	}{
+		{"below reserve", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.96)), soonestResetTierUsable},
+		{"in reserve far from reset", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.97)), soonestResetTierReserve},
+		{"in reserve within release", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(3*time.Hour), 0.98)), soonestResetTierUsable},
+		{"in floor within release", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(3*time.Hour), 0.99)), soonestResetTierFloor},
+		{"in floor far from reset", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.995)), soonestResetTierFloor},
+		{"stale after reset", claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(-time.Hour), 0.999)), soonestResetTierUsable},
+		{"override below reserve", withWeeklyReserve(claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.94)), 5), soonestResetTierUsable},
+		{"override in reserve", withWeeklyReserve(claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.95)), 5), soonestResetTierReserve},
+		{"override zero", withWeeklyReserve(claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.98)), 0), soonestResetTierUsable},
+		{"override invalid", withWeeklyReserve(claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.97)), 150), soonestResetTierReserve},
+		{"unobserved", claudeSubscription("a", time.Time{}, nil), soonestResetTierUsable},
+		{"codex in reserve", codexSubscription("a", observed, map[string]string{
+			"X-Codex-Secondary-Used-Percent":   "98",
+			"X-Codex-Secondary-Window-Minutes": "10080",
+			"X-Codex-Secondary-Reset-At":       epochSignal(now.Add(24 * time.Hour)),
+		}), soonestResetTierReserve},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			if got := soonestResetFactsFor(testCase.auth).reserveTier(now); got != testCase.tier {
+				t.Fatalf("reserveTier() = %d, want %d", got, testCase.tier)
+			}
+		})
+	}
+}
+
+func TestSoonestResetSelectorReserveTiers(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	observed := now.Add(-time.Minute)
+	reserve := claudeSubscription("a-reserve-soonest", observed, claudeWeeklyUsedSignals(now, now.Add(10*time.Hour), 0.98))
+	usable := claudeSubscription("b-usable-later", observed, claudeWeeklyUsedSignals(now, now.Add(96*time.Hour), 0.5))
+	floor := claudeSubscription("0-floor-soonest", observed, claudeWeeklyUsedSignals(now, now.Add(6*time.Hour), 0.995))
+	pick := func(auths ...*Auth) (*Auth, error) {
+		return (&SoonestResetSelector{}).Pick(context.Background(), "claude", "m", cliproxyexecutor.Options{}, auths)
+	}
+
+	if got, errPick := pick(floor, reserve, usable); errPick != nil || got.ID != usable.ID {
+		t.Fatalf("Pick() = %v, %v; want %s outside its reserve", got, errPick, usable.ID)
+	}
+	if got, errPick := pick(floor, reserve); errPick != nil || got.ID != reserve.ID {
+		t.Fatalf("Pick() = %v, %v; want the reserve %s spent before erroring", got, errPick, reserve.ID)
+	}
+
+	_, errPick := pick(floor)
+	var cooldown *modelCooldownError
+	if !errors.As(errPick, &cooldown) {
+		t.Fatalf("Pick() error = %v, want a model cooldown error when every auth is into its floor", errPick)
+	}
+	if cooldown.resetIn <= 5*time.Hour || cooldown.resetIn > 6*time.Hour {
+		t.Fatalf("resetIn = %v, want about 6h until the weekly reset", cooldown.resetIn)
+	}
+}
+
+func TestSessionAffinitySoonestResetMovesOffReservedBinding(t *testing.T) {
+	t.Parallel()
+
+	affinity := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &SoonestResetSelector{}, TTL: time.Hour})
+	t.Cleanup(affinity.Stop)
+	now := time.Now()
+	observed := now.Add(-time.Minute)
+	a := claudeSubscription("a", observed, claudeWeeklyUsedSignals(now, now.Add(24*time.Hour), 0.5))
+	b := claudeSubscription("b", observed, claudeWeeklyUsedSignals(now, now.Add(48*time.Hour), 0.5))
+	opts := func() cliproxyexecutor.Options {
+		return cliproxyexecutor.Options{Headers: http.Header{"X-Claude-Code-Session-Id": []string{"reserve-session"}}}
+	}
+
+	got, errPick := affinity.Pick(context.Background(), "claude", "", opts(), []*Auth{a, b})
+	if errPick != nil || got.ID != a.ID {
+		t.Fatalf("Pick() = %v, %v; want %s", got, errPick, a.ID)
+	}
+
+	a.Quota.Signals = claudeWeeklyUsedSignals(now, now.Add(24*time.Hour), 0.98)
+	got, errPick = affinity.Pick(context.Background(), "claude", "", opts(), []*Auth{a, b})
+	if errPick != nil || got.ID != b.ID {
+		t.Fatalf("Pick() = %v, %v; want the session moved to %s once %s is reserved", got, errPick, b.ID, a.ID)
+	}
+}
+
+func TestSoonestResetSchedulerSkipsFloorAndPrefersUsable(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	ranks := []soonestResetRank{
+		soonestResetFacts{weeklyReset: now.Add(time.Hour), hasWeeklyUsed: true, weeklyUsed: 0.98, reserveFraction: soonestResetReserveFraction, subscription: true, windowed: true}.rank(now.Add(-4*time.Hour), false),
+		soonestResetFacts{weeklyReset: now.Add(90 * time.Hour), hasWeeklyUsed: true, weeklyUsed: 0.2, subscription: true, windowed: true}.rank(now, false),
+	}
+	if !ranks[1].less(ranks[0]) {
+		t.Fatalf("usable later reset should rank before a reserve with a sooner reset: %+v vs %+v", ranks[1], ranks[0])
+	}
+}
