@@ -123,9 +152,96 @@ func (f soonestResetFacts) rank(now time.Time, probePending bool) soonestResetRa
 	return rank
 }
 
-// less reports whether r ranks strictly before other: usable before used-up credentials,
-// then by class, then known weekly resets earliest first.
+// reserveTier reports the weekly reserve tier at now.
+func (f soonestResetFacts) reserveTier(now time.Time) int {
+	if !f.hasWeeklyUsed || !f.weeklyReset.After(now) {
+		// Without a known future reset the snapshot is stale: the window rolled over.
+		return soonestResetTierUsable
+	}
+	if f.weeklyUsed >= 1-soonestResetFloorFraction {
+		return soonestResetTierFloor
+	}
+	if f.weeklyUsed >= 1-f.reserveFraction && f.weeklyReset.Sub(now) > soonestResetReserveRelease {
+		return soonestResetTierReserve
+	}
+	return soonestResetTierUsable
+}
+
+// soonestResetReserveFractionFor reads the credential's "weekly_reserve_percent" override,
+// falling back to soonestResetReserveFraction when it is missing or outside 0..100.
+func soonestResetReserveFractionFor(auth *Auth) float64 {
+	if auth == nil {
+		return soonestResetReserveFraction
+	}
+	var percent float64
+	switch raw := auth.Metadata["weekly_reserve_percent"].(type) {
+	case float64:
+		percent = raw
+	case int:
+		percent = float64(raw)
+	case int64:
+		percent = float64(raw)
+	case string:
+		parsed, errParse := strconv.ParseFloat(strings.TrimSpace(raw), 64)
+		if errParse != nil {
+			return soonestResetReserveFraction
+		}
+		percent = parsed
+	default:
+		return soonestResetReserveFraction
+	}
+	if math.IsNaN(percent) || percent < 0 || percent > 100 {
+		return soonestResetReserveFraction
+	}
+	return percent / 100
+}
+
+// soonestResetUnreserved keeps the candidates outside their weekly reserve, else those into
+// the reserve but not the floor, ranking each by its facts in known when present, else by
+// its own snapshot. When every candidate is into its floor it returns none, and earliest is
+// the soonest weekly reset among them.
+func soonestResetUnreserved(auths []*Auth, known map[string]soonestResetFacts, now time.Time) (kept []*Auth, earliest time.Time) {
+	var usable, reserve []*Auth
+	for _, candidate := range auths {
+		if candidate == nil {
+			continue
+		}
+		facts, ok := known[candidate.ID]
+		if !ok {
+			facts = soonestResetFactsFor(candidate)
+		}
+		switch facts.reserveTier(now) {
+		case soonestResetTierUsable:
+			usable = append(usable, candidate)
+		case soonestResetTierReserve:
+			reserve = append(reserve, candidate)
+		default:
+			if earliest.IsZero() || facts.weeklyReset.Before(earliest) {
+				earliest = facts.weeklyReset
+			}
+		}
+	}
+	if len(usable) > 0 {
+		return usable, time.Time{}
+	}
+	return reserve, earliest
+}
+
+// soonestResetReservedError reports that every candidate is into its weekly floor.
+func soonestResetReservedError(provider, model string, earliest, now time.Time) error {
+	if provider == "mixed" {
+		provider = ""
+	}
+	return newModelCooldownError(model, provider, earliest.Sub(now))
+}
+
+// less reports whether r ranks strictly before other: outside the weekly reserve before
+// into it, then usable before used-up credentials, then by class, then known weekly resets
+// earliest first.
 func (r soonestResetRank) less(other soonestResetRank) bool {
+	if r.tier != other.tier {
+		return r.tier < other.tier
+	}
 	if r.exhausted != other.exhausted {
 		return !r.exhausted
 	}
