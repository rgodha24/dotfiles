diff --git a/sdk/cliproxy/auth/selector_priority_affinity_test.go b/sdk/cliproxy/auth/selector_priority_affinity_test.go
new file mode 100644
index 0000000..c381053
--- /dev/null
+++ b/sdk/cliproxy/auth/selector_priority_affinity_test.go
@@ -0,0 +1,38 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestSessionAffinityReturnsToHigherPriorityTier(t *testing.T) {
+	t.Parallel()
+
+	selector := NewSessionAffinitySelector(&RoundRobinSelector{})
+	t.Cleanup(selector.Stop)
+
+	sub := &Auth{ID: "subscription", Provider: "claude", Status: StatusActive}
+	key := &Auth{ID: "api-key", Provider: "claude", Status: StatusActive, Attributes: map[string]string{"priority": "-10"}}
+	opts := cliproxyexecutor.Options{Headers: http.Header{"X-Claude-Code-Session-Id": []string{"fallback-session"}}}
+
+	// The subscription is out, so the session binds to the fallback key.
+	got, err := selector.Pick(context.Background(), "claude", "claude-sonnet-4-6", opts, []*Auth{key})
+	if err != nil || got == nil || got.ID != key.ID {
+		t.Fatalf("Pick() with only the fallback = %v, %v; want %s", got, err, key.ID)
+	}
+
+	// The subscription recovers: the binding must not hold the session on the fallback tier.
+	got, err = selector.Pick(context.Background(), "claude", "claude-sonnet-4-6", opts, []*Auth{sub, key})
+	if err != nil || got == nil || got.ID != sub.ID {
+		t.Fatalf("Pick() after recovery = %v, %v; want %s", got, err, sub.ID)
+	}
+
+	// And the session is now bound to the subscription.
+	got, err = selector.Pick(context.Background(), "claude", "claude-sonnet-4-6", opts, []*Auth{sub, key})
+	if err != nil || got == nil || got.ID != sub.ID {
+		t.Fatalf("Pick() after rebinding = %v, %v; want %s", got, err, sub.ID)
+	}
+}
