{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "permission": "allow",
  "model": "cliproxy-go/glm-5.3",
  "provider": {
    "cliproxy": {
      "name": "CLIProxyAPI",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "cliproxy",
      },
      "models": {
        "gpt-6-astra": {},
        "gpt-6.1-sol": {},
        "gpt-6.1-terra": {},
        "gpt-6-luna": {},
      },
    },
    // opencode go, with the key held by the hub (home/cliproxyapi.nix)
    "cliproxy-go": {
      "name": "OpenCode Go (CLIProxyAPI)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "cliproxy",
      },
      "models": {
        "kimi-k3.1-pro": { "reasoning": true, "tool_call": true },
        "kimi-k3": { "reasoning": true, "tool_call": true },
        "glm-5.3": { "reasoning": true, "tool_call": true },
        "glm-5.3-flash": { "reasoning": true, "tool_call": true },
        "deepseek-v4-pro": {
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
        },
        "deepseek-v4.1-flash": {
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
        },
        "mimo-v2.6-pro": { "reasoning": true, "tool_call": true },
        "minimax-m3.1-flash": { "reasoning": true, "tool_call": true },
      },
    },
  },
}
